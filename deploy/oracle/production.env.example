# Copy to .env.production at the repository root. Never commit real secrets.
APP_DOMAIN=outreach.example.org
DJANGO_ENV=production
DEBUG=False
ALLOWED_HOSTS=outreach.example.org
CSRF_TRUSTED_ORIGINS=https://outreach.example.org
SECRET_KEY=replace-with-at-least-50-random-characters
MAILBOX_ENCRYPTION_KEY=replace-with-a-different-random-secret
MAILBOX_ENCRYPTION_OLD_KEYS=
# Generate with secrets.token_hex(32); hexadecimal avoids URL escaping issues.
POSTGRES_PASSWORD=replace-with-random-hex
TIME_ZONE=Asia/Kolkata
USE_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Keep the app's Vertex backend; configure server credentials as in README.
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-adc.json
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
ALLOW_STATIC_EMAIL_FALLBACK=False

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
SMTP_TIMEOUT_SECONDS=30
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USE_SSL=True
IMAP_TIMEOUT_SECONDS=30
CELERY_RESULT_BACKEND=django-db
