# Copy this file to .env and fill in real values. Never commit .env to git.

# Django
SECRET_KEY=replace-me-with-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=parthsethi@180dc.org
EMAIL_HOST_PASSWORD=your-16-char-app-password-here
DEFAULT_FROM_EMAIL=parthsethi@180dc.org
OUTREACH_CC_EMAILS=arghyadip.pal@180dc.org,mishra.moulik@180dc.org

# IMAP (for scanning replies)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Google Gemini AI
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Corrective re-generations when a draft fails the content quality gate — e.g.
# Gemini returned the sample email's "[Company]" / "[specific domain]" slots
# unfilled. Costs one extra call, and only on drafts that would otherwise be
# unsendable. 0 disables repair (a failed draft falls back to the template).
AI_MAX_REPAIR_ATTEMPTS=1

# Google-Search-grounded company research is cached per company instead of
# being re-run per contact. Successful summaries are reused for this many
# days; empty ones are retried after a few hours, since an empty result is
# usually transient and reusing it would keep that company's emails generic.
RESEARCH_CACHE_TTL_DAYS=30
RESEARCH_EMPTY_RETRY_HOURS=6

# Field-level encryption for mailbox app-passwords stored in the DB.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production (DEBUG=False); optional in local dev.
ENCRYPTION_KEY=

# Username of the TeamMember whose mailbox is used to send unattended,
# Celery-Beat-triggered follow-ups/reply-scans (no interactive user to resolve
# credentials from in that case). Leave blank to disable scheduled runs.
AUTOMATED_SENDER_USERNAME=

# Optional error tracking (free tier). Leave blank to disable.
SENTRY_DSN=

# Celery / Redis
# Option A — Redis (after installing from github.com/tporadowski/redis/releases,
# or a free-tier hosted Redis such as Upstash/Redis Cloud in production):
CELERY_BROKER_URL=redis://localhost:6379/0
# Option B — No Redis, no Docker (dev only). Uncomment the line below instead:
# CELERY_BROKER_URL=filesystem://
# Set to True only for quick local testing without a worker running — tasks then
# execute synchronously in-process. Never leave this True in a real deployment;
# it silently disables inter-send rate limiting. Independent of DEBUG.
CELERY_TASK_ALWAYS_EAGER=False
