# Copy this file to .env and fill in real values. Never commit .env to git.

# Runtime
DJANGO_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Kolkata
DATABASE_URL=sqlite:///db.sqlite3
DATABASE_SSL_REQUIRE=False

# Encrypts per-user mailbox app passwords in the database. Use a separate
# random value from SECRET_KEY.
MAILBOX_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
MAILBOX_ENCRYPTION_OLD_KEYS=

# Gemini / Google Search grounding. This AI Studio key is independent from
# Gmail SMTP/IMAP credentials and should not be reused for other Google APIs.
GEMINI_API_KEY=
# Optional separate key for a non-Gemini Google Cloud service used elsewhere.
GOOGLE_CLOUD_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_SECONDS=0.5
# Safer default: a Gemini failure does not send a generic template.
ALLOW_STATIC_EMAIL_FALLBACK=False

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
SMTP_TIMEOUT_SECONDS=30
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
OUTREACH_CC_EMAILS=

# Reply scanning. Actual mailbox credentials are set per user in the app.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USE_SSL=True
IMAP_TIMEOUT_SECONDS=30

# Celery: eager mode is simplest for a small local test and does not use Redis.
# Broker value used after eager mode is disabled:
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db
CELERY_TASK_ALWAYS_EAGER=True
# For shared/production use, set this to False and run Redis plus a Celery worker.
# Optional filesystem broker for development only:
# CELERY_BROKER_URL=filesystem://
